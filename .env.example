# Sao chép thành .env rồi export, hoặc truyền trực tiếp khi chạy.
HTTP_ADDR=:8080
# memory | postgres
STORAGE=memory
DATABASE_URL=postgres://userapi:userapi@localhost:5432/userapi?sslmode=disable
# debug | info | warn | error
LOG_LEVEL=info
# Chờ sau SIGTERM trước khi đóng listener (Kubernetes: 5s-10s)
SHUTDOWN_DELAY=0s
SHUTDOWN_TIMEOUT=10s
REQUEST_TIMEOUT=10s
# Phải lớn hơn idle timeout của load balancer (AWS ALB: 60s)
HTTP_IDLE_TIMEOUT=75s
# CIDR của load balancer / ingress, phân tách bằng dấu phẩy. Rỗng = dùng IP của kết nối TCP.
TRUSTED_PROXIES=
READINESS_CHECK_DB=false

# Pool PostgreSQL (luôn đặt tường minh khi chạy trong container)
DB_MAX_CONNS=10
DB_MIN_CONNS=0
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
DB_STATEMENT_TIMEOUT=5s
# Chạy migration khi khởi động (tiện cho dev). Production: chạy `userapi migrate` riêng.
MIGRATE_ON_START=false

# Phát sự kiện qua transactional outbox (docs/events.md). none | kafka; kafka cần STORAGE=postgres.
# API và `userapi relay` dùng cùng cấu hình này.
EVENTS_SINK=none
KAFKA_BROKERS=
KAFKA_TOPIC=users
OUTBOX_POLL_INTERVAL=1s
OUTBOX_BATCH_SIZE=100
OUTBOX_RETENTION=168h

# OpenTelemetry (biến chuẩn của OTel SDK). Bỏ trống endpoint = tắt export.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=userapi
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1
