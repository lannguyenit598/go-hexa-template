# Sao chép thành .env rồi export, hoặc truyền trực tiếp khi chạy.
HTTP_ADDR=:8080
# memory | postgres
STORAGE=memory
DATABASE_URL=postgres://userapi:userapi@localhost:5432/userapi?sslmode=disable
# debug | info | warn | error
LOG_LEVEL=info
# Chờ sau SIGTERM trước khi đóng listener (Kubernetes: 5s-10s)
SHUTDOWN_DELAY=0s
SHUTDOWN_TIMEOUT=10s
REQUEST_TIMEOUT=10s
# CIDR của load balancer / ingress, phân tách bằng dấu phẩy. Rỗng = dùng IP của kết nối TCP.
TRUSTED_PROXIES=
READINESS_CHECK_DB=false

# Pool PostgreSQL (luôn đặt tường minh khi chạy trong container)
DB_MAX_CONNS=10
DB_MIN_CONNS=0
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
DB_STATEMENT_TIMEOUT=5s
